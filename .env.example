# Local app origin for Supabase email callback URLs. Must remain loopback-only.
# APP_ORIGIN=http://127.0.0.1:3100
# Future private Supabase integration (not used by the demo).
# No credentials are required to run the demo. Uncomment and fill in only
# for the later authenticated phase. Never commit real values.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=